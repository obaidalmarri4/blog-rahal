<script type="application/json" id="rh-country-data" set:html={JSON.stringify(COUNTRY_POSTS).replace(/</g, '\\u003c')} />

<script>
  import { initAtlas } from '../scripts/atlas';

  const el = document.getElementById('rh-globe');
  if (el) {
    const dataEl = document.getElementById('rh-country-data');
    let countryData = {};
    try {
      countryData = JSON.parse(dataEl?.textContent || '{}');
    } catch (e) {
      console.error('[atlas] country data parse failed', e);
    }
    initAtlas(el, countryData);
  }
</script>

