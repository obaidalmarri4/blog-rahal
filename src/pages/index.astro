---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts, getExcerpt, getPostCoverImage, getPostSlug } from '../utils/posts';

const allPosts = await getAllPosts();
const latestPosts = allPosts.slice(0, 9);
---

<BaseLayout title="رحّال الخبر — مدوّنة السفر والتوثيق الحضاري">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-[#0f3460] via-[#1a1a2e] to-[#16213e] text-white py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 right-20 text-9xl">🌍</div>
      <div class="absolute bottom-10 left-20 text-8xl">✈️</div>
      <div class="absolute top-1/2 left-1/2 text-7xl">🏔️</div>
    </div>
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
      <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
        رحّال <span class="text-[#e94560]">الخبر</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 mb-4 leading-relaxed">
        الحياة رحلة ، والكل مرتحل وراحل عنها
      </p>
      <p class="text-gray-400 text-lg">
        د. وائل بن عبدالعزيز الدغفق — توثيق رحلات عبر أكثر من <span class="font-num">175</span> دولة
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a href="/blog" class="px-8 py-3 bg-[#e94560] hover:bg-[#d63851] text-white rounded-full font-medium transition-colors">
          تصفح الرحلات
        </a>
        <a href="/about" class="px-8 py-3 border border-white/30 hover:bg-white/10 text-white rounded-full font-medium transition-colors">
          عن الرحّال
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="max-w-4xl mx-auto px-4 -mt-8 relative z-20">
    <div class="grid grid-cols-3 gap-4">
      <div class="bg-white dark:bg-[#1e293b] rounded-2xl p-6 text-center shadow-lg border border-gray-100 dark:border-gray-700">
        <p class="text-3xl font-bold text-[#e94560] font-num">{allPosts.length}+</p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">تدوينة</p>
      </div>
      <div class="bg-white dark:bg-[#1e293b] rounded-2xl p-6 text-center shadow-lg border border-gray-100 dark:border-gray-700">
        <p class="text-3xl font-bold text-[#0f3460] dark:text-blue-400 font-num">175+</p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">دولة</p>
      </div>
      <div class="bg-white dark:bg-[#1e293b] rounded-2xl p-6 text-center shadow-lg border border-gray-100 dark:border-gray-700">
        <p class="text-3xl font-bold text-[#533483] dark:text-purple-400 font-num">40+</p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">سنة ترحال</p>
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
        آخر <span class="text-[#e94560]">الرحلات</span>
      </h2>
      <a href="/blog" class="text-[#e94560] hover:underline font-medium">
        عرض الكل ←
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {latestPosts.map(post => (
        <PostCard
          title={post.title}
          date={post.date}
          slug={getPostSlug(post)}
          excerpt={getExcerpt(post.content_text)}
          image={getPostCoverImage(post)}
          labels={post.labels}
        />
      ))}
    </div>
  </section>
</BaseLayout>
