---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContinentCard from '../../components/ContinentCard.astro';
import { getContinents, getOtherPosts } from '../../utils/posts';

const continents = getContinents();
const otherCategories = await getOtherPosts();
const totalOtherPosts = otherCategories.reduce((sum, cat) => sum + cat.posts.length, 0);
---

<BaseLayout title="الوجهات — رحّال الخبر">

  <!-- Atlas Header -->
  <section style="background:#1f1a14; border-bottom:1px solid #c9a04a40; padding:3rem 0 2rem;">
    <div class="max-w-5xl mx-auto px-4">
      <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.25em; color:#6b7d5a; margin-bottom:0.75rem;">
        ATLAS ROUTES · مسارات الأطلس
      </div>
      <h1 style="font-family:'Thmanyah Serif Display',serif; font-size:2.5rem; color:#f0e6d2; font-weight:700; margin-bottom:0.5rem;">
        الوجهات
      </h1>
      <p style="font-family:'Thmanyah Serif Display',serif; font-size:0.9rem; color:#c9a04a;">
        رحلات موثّقة عبر {continents.length} قارات ومئات الدول
      </p>
    </div>
  </section>

  <!-- Continents Grid -->
  <section style="background:#1f1a14; padding:3rem 0;">
    <div class="max-w-5xl mx-auto px-4">

      <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; color:#c9a04a; margin-bottom:1.5rem; border-bottom:1px solid #c9a04a30; padding-bottom:0.75rem;">
        ✦ CONTINENTS · القارات
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {continents.map(continent => (
          <ContinentCard
            name={continent.name}
            emoji={continent.emoji}
            slug={continent.slug}
            postCount={continent.postCount}
            countryCount={continent.countryCount}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Other Posts Section -->
  {totalOtherPosts > 0 && (
    <section style="background:#1f1a14; padding:0 0 4rem;">
      <div class="max-w-5xl mx-auto px-4">

        <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; color:#c9a04a; margin-bottom:1.5rem; border-bottom:1px solid #c9a04a30; padding-bottom:0.75rem;">
          ✦ OTHER ENTRIES · مقالات أخرى
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {otherCategories.map(cat => (
            <a href="/destinations/other"
               style="display:block; padding:1.25rem; border:1px dashed #c9a04a50; text-decoration:none; transition:border-color 0.2s, background 0.2s;"
               onmouseover="this.style.borderColor='#c9a04a'; this.style.background='#c9a04a10';"
               onmouseout="this.style.borderColor='#c9a04a50'; this.style.background='transparent';">
              <h3 style="font-family:'Thmanyah Serif Display',serif; font-size:1.1rem; color:#f0e6d2; font-weight:700; margin-bottom:0.25rem;">{cat.category}</h3>
              <p style="font-family:'JetBrains Mono',monospace; font-size:10px; color:#6b7d5a;">
                {cat.posts.length} ENTRIES
              </p>
            </a>
          ))}
        </div>

        <div style="margin-top:1.5rem;">
          <a href="/destinations/other"
             style="font-family:'Thmanyah Serif Display',serif; font-size:0.85rem; color:#c9a04a; text-decoration:underline; text-underline-offset:3px;">
            عرض جميع المقالات ({totalOtherPosts}) →
          </a>
        </div>
      </div>
    </section>
  )}

</BaseLayout>
