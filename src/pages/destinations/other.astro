---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getOtherPosts, getExcerpt, getPostCoverImage, getPostSlug } from '../../utils/posts';

const categories = await getOtherPosts();
const totalPosts = categories.reduce((sum, cat) => sum + cat.posts.length, 0);

const categoryEmojis: Record<string, string> = {
  'تراث محلي': '🏛️',
  'تاريخ وثقافة': '📜',
  'نصائح سفر': '💡',
  'طعام ومشروبات': '☕',
  'عام': '📝',
};
---

<BaseLayout title="مقالات أخرى — رحّال الخبر">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#0f3460] via-[#1a1a2e] to-[#16213e] text-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="text-sm text-gray-400 mb-4">
        <a href="/destinations" class="hover:text-white transition-colors">الوجهات</a>
        <span class="mx-2">›</span>
        <span class="text-white">مقالات أخرى</span>
      </nav>
      <div class="text-center">
        <div class="text-6xl mb-4">📚</div>
        <h1 class="text-4xl md:text-5xl font-bold mb-2">مقالات أخرى</h1>
        <p class="text-xl text-gray-300">
          <span class="font-num">{totalPosts}</span> مقال في التاريخ والثقافة والتراث ونصائح السفر
        </p>
      </div>
    </div>
  </section>

  <!-- Categories -->
  {categories.map(cat => (
    <section class="max-w-6xl mx-auto px-4 py-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
        <span>{categoryEmojis[cat.category] || '📄'}</span>
        <span>{cat.category}</span>
        <span class="text-sm font-normal text-gray-500 dark:text-gray-400 font-num">({cat.posts.length})</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cat.posts.map(post => (
          <PostCard
            title={post.title}
            date={post.date}
            slug={getPostSlug(post)}
            excerpt={getExcerpt(post.content_text)}
            image={getPostCoverImage(post)}
            labels={post.labels}
          />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
