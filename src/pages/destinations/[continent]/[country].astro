---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getAllContinentSlugs, getAllCountrySlugsForContinent, getContinentBySlug, getCountryBySlug, getPostsByCountry, getExcerpt, getPostCoverImage, getPostSlug } from '../../../utils/posts';

export async function getStaticPaths() {
  const continentSlugs = getAllContinentSlugs();
  const paths: { params: { continent: string; country: string } }[] = [];

  for (const cSlug of continentSlugs) {
    const countrySlugs = getAllCountrySlugsForContinent(cSlug);
    for (const countrySlug of countrySlugs) {
      paths.push({ params: { continent: cSlug, country: countrySlug } });
    }
  }

  return paths;
}

const { continent: continentSlug, country: countrySlug } = Astro.params;
const continent = getContinentBySlug(continentSlug!);
const country = getCountryBySlug(countrySlug!);

if (!continent || !country) {
  return Astro.redirect('/destinations');
}

const posts = await getPostsByCountry(country.name);
---

<BaseLayout title={`${country.name} — رحّال الخبر`}>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#0f3460] via-[#1a1a2e] to-[#16213e] text-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="text-sm text-gray-400 mb-4">
        <a href="/destinations" class="hover:text-white transition-colors">الوجهات</a>
        <span class="mx-2">›</span>
        <a href={`/destinations/${continentSlug}/`} class="hover:text-white transition-colors">{continent.name}</a>
        <span class="mx-2">›</span>
        <span class="text-white">{country.name}</span>
      </nav>
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-2">{country.name}</h1>
        <p class="text-xl text-gray-300">
          <span class="font-num">{posts.length}</span> تدوينة عن {country.name}
        </p>
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <PostCard
          title={post.title}
          date={post.date}
          slug={getPostSlug(post)}
          excerpt={getExcerpt(post.content_text)}
          image={getPostCoverImage(post)}
          labels={post.labels}
        />
      ))}
    </div>
  </section>
</BaseLayout>
