---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getPostSlug, getPostCoverImage } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map(post => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;

const formattedDate = (() => {
  try {
    const d = new Date(post.date);
    return d.toLocaleDateString('ar-SA', {
      year: 'numeric', month: 'long', day: 'numeric',
      weekday: 'long'
    });
  } catch {
    return post.date;
  }
})();

const coverImage = getPostCoverImage(post);
---

<BaseLayout title={`${post.title} — رحّال الخبر`} description={post.content_text?.substring(0, 160)}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <!-- Back Link -->
    <a href="/blog" class="inline-flex items-center gap-2 text-[#e94560] hover:underline mb-8 font-medium">
      → العودة للمدوّنة
    </a>

    <!-- Cover Image -->
    {coverImage && (
      <div class="rounded-2xl overflow-hidden mb-8 shadow-lg">
        <img src={coverImage} alt={post.title} class="w-full h-auto" />
      </div>
    )}

    <!-- Post Header -->
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white leading-tight mb-4">
        {post.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
        <span class="flex items-center gap-1">
          📅 {formattedDate}
        </span>
        {post.image_count > 0 && (
          <span class="flex items-center gap-1">
            🖼️ {post.image_count} صورة
          </span>
        )}
      </div>

      {post.labels && post.labels.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {post.labels.map((label: string) => (
            <span class="text-xs px-3 py-1 bg-[#e94560]/10 text-[#e94560] rounded-full font-medium">
              {label}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Divider -->
    <hr class="border-gray-200 dark:border-gray-700 mb-10" />

    <!-- Post Content -->
    <div class="post-content text-gray-800 dark:text-gray-200" set:html={post.content_html} />

    <!-- Author Footer -->
    <div class="mt-16 p-6 bg-gray-50 dark:bg-[#1e293b] rounded-2xl border border-gray-100 dark:border-gray-700">
      <div class="flex items-center gap-4">
        <span class="text-4xl">🧭</span>
        <div>
          <p class="font-bold text-gray-900 dark:text-white">د. وائل الدغفق</p>
          <p class="text-sm text-gray-500 dark:text-gray-400">رحّال الخبر — الحياة رحلة</p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
