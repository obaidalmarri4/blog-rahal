---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, getContinents } from '../utils/posts';

const allPosts = await getAllPosts();
const continents = getContinents();
const totalCountries = continents.reduce((s, c) => s + c.countryCount, 0);
---

<BaseLayout title="عن الرحّال — رحّال الخبر">

  <!-- Dark header band -->
  <section style="background:#1f1a14; border-bottom:2px solid #c9a04a40; padding:3rem 0 2rem;">
    <div class="max-w-4xl mx-auto px-4">
      <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.25em; color:#6b7d5a; margin-bottom:0.75rem;">
        FIELD AGENT · PROFILE
      </div>
      <h1 style="font-family:'Thmanyah Serif Display',serif; font-size:2.5rem; color:#f0e6d2; font-weight:700;">
        عن <span style="color:#c8612e;">الرحّال</span>
      </h1>
    </div>
  </section>

  <!-- Paper content area -->
  <section style="background:#f0e6d2; color:#2a2218; padding:3rem 0 4rem;">
    <div class="max-w-4xl mx-auto px-4">

      <!-- Author block -->
      <div style="display:flex; align-items:flex-start; gap:2rem; margin-bottom:2.5rem; flex-wrap:wrap;">
        <!-- Concentric circle avatar -->
        <div style="flex-shrink:0;">
          <svg width="100" height="100" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="48" stroke="#c9a04a" stroke-width="1"/>
            <circle cx="50" cy="50" r="38" stroke="#c9a04a" stroke-width="0.7" opacity="0.6"/>
            <circle cx="50" cy="50" r="28" stroke="#c9a04a" stroke-width="0.5" opacity="0.5"/>
            <circle cx="50" cy="50" r="5" fill="#c8612e" opacity="0.9"/>
            <text x="50" y="54" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="8" fill="#c9a04a">26.3°N</text>
          </svg>
        </div>

        <div>
          <h2 style="font-family:'Thmanyah Serif Display',serif; font-size:1.75rem; font-weight:700; color:#1f1a14; margin-bottom:0.25rem;">
            د. وائل بن عبدالعزيز الدغفق
          </h2>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.15em; color:#c8612e; margin-bottom:0.5rem;">
            RAHHAL · EST 1980 · KHOBAR KSA
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; color:#6b7d5a; letter-spacing:0.1em;">
            26.279°N · 50.208°E
          </div>
        </div>
      </div>

      <!-- Ochre rule -->
      <div style="height:1px; background:linear-gradient(to left, transparent, #c9a04a, transparent); margin-bottom:2rem;"></div>

      <!-- Bio -->
      <div style="font-family:'Thmanyah Serif Display',serif; font-size:1.2rem; line-height:2; color:#2a2218; margin-bottom:2.5rem;">
        <p style="margin-bottom:1rem;">
          رحّال سعودي متمرّس، قضى أكثر من 47 عاماً في استكشاف العالم وتوثيق الحضارات والثقافات المختلفة. زار أكثر من 189 دولة حول العالم.
        </p>
        <p style="margin-bottom:1rem;">
          تتميز رحلاته بالعمق الثقافي والتوثيق الحضاري، حيث يجمع بين المتعة والمعرفة في كل رحلة، مع اهتمام خاص بالمجتمعات الإسلامية والمواقع التاريخية.
        </p>
        <p>
          هذه المدوّنة هي سجل لرحلاته وخواطره ومشاهداته من مختلف بقاع الأرض، موثّقةً منذ عام 1980.
        </p>
      </div>

      <!-- Stats grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div style="border:1px solid #c9a04a; padding:1.25rem; text-align:center; background:#e8dcc4;">
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:2.5rem; font-weight:700; color:#c8612e; line-height:1;">189</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; color:#6b7d5a; margin-top:6px;">NATIONS</div>
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:0.75rem; color:#3a5566; margin-top:2px;">دولة</div>
        </div>
        <div style="border:1px solid #c9a04a; padding:1.25rem; text-align:center; background:#e8dcc4;">
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:2.5rem; font-weight:700; color:#c8612e; line-height:1;">47</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; color:#6b7d5a; margin-top:6px;">YEARS</div>
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:0.75rem; color:#3a5566; margin-top:2px;">سنة ترحال</div>
        </div>
        <div style="border:1px solid #c9a04a; padding:1.25rem; text-align:center; background:#e8dcc4;">
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:2.5rem; font-weight:700; color:#c8612e; line-height:1;">{allPosts.length}</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; color:#6b7d5a; margin-top:6px;">ENTRIES</div>
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:0.75rem; color:#3a5566; margin-top:2px;">تدوينة</div>
        </div>
        <div style="border:1px solid #c9a04a; padding:1.25rem; text-align:center; background:#e8dcc4;">
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:2.5rem; font-weight:700; color:#c8612e; line-height:1;">{continents.length}</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; color:#6b7d5a; margin-top:6px;">CONTINENTS</div>
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:0.75rem; color:#3a5566; margin-top:2px;">قارات</div>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
