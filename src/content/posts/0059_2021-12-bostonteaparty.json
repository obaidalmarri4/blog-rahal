  "content_html": "<div class=\"post-body entry-content\" id=\"post-body-5435177193572108169\" itemprop=\"description articleBody\">\n<div><br/></div><div><div class=\"wrap\"><header class=\"rtl notranslate\" role=\"banner \"><div class=\"logo-wrap\"><div class=\"box-shadow menu\"><div class=\"menu-row link\"><div class=\"d-block d-md-none col col-no-padding notranslate\"><div class=\"mobile-header ng-scope\" ng-controller=\"modechanger\"> <a class=\"btn\" href=\"https://rattibha.com/search\"><i class=\"fas fa-search\"></i></a> <a class=\"notranslate\" href=\"https://rattibha.com/hashtag/Boston_Tea_Party\">Boston_Tea_Party</a><a aria-controls=\"navbarMenu\" aria-expanded=\"true\" class=\"btn toggle\" data-toggle=\"collapse\" href=\"https://rattibha.com/thread/1472168233146929154?lang=ar&amp;gt_lang=en#navbarMenu\" role=\"button\"><i class=\"fas fa-bars\"></i></a></div><div class=\"mobile-header ng-scope\" ng-controller=\"modechanger\"><br/></div></div></div></div><nav class=\"navbar navbar-expand-md navbar-light rtl d-block d-md-none box-shadow\"><div class=\"container\"></div></nav></div></header><div class=\"container animated fadeIn\" id=\"main\"><section class=\"site-section py-sm col-sm-10 col-lg-10 col-xs-10 col-md-8 mx-auto\"><div class=\"ng-scope\" keep-scroll-pos=\"\" ng-show=\"!view_loading &amp;&amp; !main_loading\" ng-view=\"\"><div class=\"thread_page ng-scope\" id=\"thread_page\"><div class=\"row blog-entries\"><div class=\"col-xs-10 col-sm-10 col-md-11 col-lg-8 mx-auto rtl\" id=\"scrolldiv\" ng-class=\"getDirection(current_language)\" ng-show=\"!notfound\"><div class=\"post-meta p-1 col-md-12 mx-auto mt-1\" ng-show=\"!main_loading &amp;&amp; tweet != undefined\"><span class=\"author row p-2\"><div class=\"d-flex ml-2 align-self-center\"><a href=\"https://rattibha.com/aldaqfaq\" ng-href=\"/aldaqfaq\"><img alt=\"\" class=\"mr-2\" ng-src=\"https://pbs.twimg.com/profile_images/1356589626769686528/3gNt1mBh.jpg\" src=\"https://pbs.twimg.com/profile_images/1