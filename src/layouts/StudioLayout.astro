---
/**
 * هيكل صفحات لوحة التحرير. لا رأس الموقع ولا تذييله ولا خطوط Google — اللوحة غير مربوطة
 * بالموقع العام من أي جهة، والمحرِّر فيها يحتاج الشاشة كلها.
 */
import '../styles/global.css';
import '../styles/studio.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="studio">
    <header class="studio-bar">
      <div class="studio-bar__inner">
        <div class="studio-bar__title">لوحة التحرير<span>رحّال الخبر</span></div>
        <a class="studio-bar__link" href="/" target="_blank" rel="noopener">عرض الموقع</a>
      </div>
    </header>
    <main class="studio-main">
      <slot />
    </main>
  </body>
</html>
