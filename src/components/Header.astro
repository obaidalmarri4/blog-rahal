---
const navLinks = [
  { href: '/', label: 'الرئيسية' },
  { href: '/destinations', label: 'الوجهات' },
  { href: '/blog', label: 'المدوّنة' },
  { href: '/about', label: 'عن الرحّال' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-[#0f172a]/80 border-b border-gray-200 dark:border-gray-700">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <span class="text-2xl md:text-3xl">🧭</span>
      <div>
        <h1 class="text-base md:text-xl font-bold text-gray-900 dark:text-white group-hover:text-[#e94560] transition-colors">
          رحّال الخبر
        </h1>
        <p class="text-[10px] md:text-xs text-gray-500 dark:text-gray-400 hidden sm:block">الحياة رحلة</p>
      </div>
    </a>

    <!-- Nav Links (desktop) -->
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <a href={link.href}
           class="text-gray-600 dark:text-gray-300 hover:text-[#e94560] transition-colors font-medium">
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <!-- Theme Toggle -->
      <button id="theme-toggle"
              class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
              aria-label="تبديل الوضع">
        <svg id="sun-icon" class="w-5 h-5 hidden dark:block text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
        </svg>
        <svg id="moon-icon" class="w-5 h-5 block dark:hidden text-gray-600" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn"
              class="md:hidden p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
              aria-label="القائمة">
        <svg class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-[#0f172a]">
    <div class="px-4 py-3 space-y-2">
      {navLinks.map(link => (
        <a href={link.href}
           class="block py-2 text-gray-600 dark:text-gray-300 hover:text-[#e94560] font-medium transition-colors">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme',
      document.documentElement.classList.contains('dark') ? 'dark' : 'light'
    );
  });

  document.getElementById('mobile-menu-btn').addEventListener('click', () => {
    document.getElementById('mobile-menu').classList.toggle('hidden');
  });
</script>
