---
interface Props {
  name: string;
  emoji: string;
  slug: string;
  postCount: number;
  countryCount: number;
}

const { name, emoji, slug, postCount, countryCount } = Astro.props;

const gradients: Record<string, string> = {
  'asia': 'from-amber-500 to-orange-600',
  'europe': 'from-blue-500 to-indigo-600',
  'africa': 'from-green-600 to-emerald-700',
  'south-america': 'from-red-500 to-pink-600',
  'north-america': 'from-purple-500 to-violet-600',
  'middle-east': 'from-yellow-600 to-amber-700',
  'oceania': 'from-cyan-500 to-teal-600',
};

const gradient = gradients[slug] || 'from-gray-500 to-gray-600';
---

<a href={`/destinations/${slug}/`} class="group block">
  <div class={`relative overflow-hidden rounded-2xl bg-gradient-to-br ${gradient} p-6 md:p-8 shadow-lg transition-all duration-300 group-hover:shadow-2xl group-hover:scale-[1.02]`}>
    <div class="absolute top-4 left-4 text-6xl opacity-20 group-hover:opacity-30 transition-opacity">
      {emoji}
    </div>
    <div class="relative z-10 text-white">
      <div class="text-4xl mb-3">{emoji}</div>
      <h3 class="text-2xl font-bold mb-2">{name}</h3>
      <div class="flex gap-4 text-white/80 text-sm">
        <span class="font-num">{countryCount} <span class="text-white/60">دولة</span></span>
        <span class="font-num">{postCount} <span class="text-white/60">تدوينة</span></span>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 w-full h-1 bg-white/20 group-hover:bg-white/40 transition-colors"></div>
  </div>
</a>
