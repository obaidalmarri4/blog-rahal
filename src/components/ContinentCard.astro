---
interface Props {
  name: string;
  emoji: string;
  slug: string;
  postCount: number;
  countryCount: number;
}

const { name, emoji, slug, postCount, countryCount } = Astro.props;

const accentColors: Record<string, string> = {
  'asia': '#c8612e',
  'europe': '#3a5566',
  'africa': '#6b7d5a',
  'south-america': '#c8612e',
  'north-america': '#3a5566',
  'middle-east': '#c9a04a',
  'oceania': '#6b7d5a',
};

const accent = accentColors[slug] || '#c9a04a';
---

<a href={`/destinations/${slug}/`} style="display:block; text-decoration:none; group:true;">
  <div style={`border:1px solid ${accent}50; padding:1.5rem; background:#1f1a14; transition:border-color 0.2s, background 0.2s; position:relative; overflow:hidden;`}
       onmouseover={`this.style.borderColor='${accent}'; this.style.background='${accent}10';`}
       onmouseout={`this.style.borderColor='${accent}50'; this.style.background='#1f1a14';`}>

    <!-- Background emoji (faded) -->
    <div style="position:absolute; bottom:-10px; left:-5px; font-size:80px; opacity:0.06; pointer-events:none; user-select:none;">
      {emoji}
    </div>

    <!-- Content -->
    <div style="position:relative; z-index:1;">
      <!-- Emoji + label -->
      <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
        <span style="font-size:1.5rem;">{emoji}</span>
        <div style={`font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; color:${accent};`}>
          {slug.toUpperCase().replace(/-/g, ' ')}
        </div>
      </div>

      <h3 style="font-family:'Thmanyah Serif Display',serif; font-size:1.4rem; color:#f0e6d2; font-weight:700; margin-bottom:0.75rem;">
        {name}
      </h3>

      <!-- Stats -->
      <div style={`display:flex; gap:1.5rem; border-top:1px solid ${accent}30; padding-top:0.75rem;`}>
        <div>
          <div style={`font-family:'JetBrains Mono',monospace; font-size:11px; color:${accent}; font-weight:500;`}>{countryCount}</div>
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:10px; color:#6b7d5a;">دولة</div>
        </div>
        <div>
          <div style={`font-family:'JetBrains Mono',monospace; font-size:11px; color:${accent}; font-weight:500;`}>{postCount}</div>
          <div style="font-family:'Thmanyah Serif Display',serif; font-size:10px; color:#6b7d5a;">تدوينة</div>
        </div>
      </div>
    </div>

  </div>
</a>
