---
interface Props {
  title: string;
  date: string;
  slug: string;
  excerpt: string;
  image?: string;
  labels?: string[];
}

const { title, date, slug, excerpt, image, labels = [] } = Astro.props;

// Format date
const formattedDate = (() => {
  try {
    const d = new Date(date);
    return d.toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' });
  } catch {
    return date;
  }
})();
---

<article class="group bg-white dark:bg-[#1e293b] rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-gray-700 hover:border-[#e94560]/30">
  <a href={`/blog/${slug}`} class="block">
    {image ? (
      <div class="aspect-video overflow-hidden">
        <img src={image} alt={title} loading="lazy"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
      </div>
    ) : (
      <div class="aspect-video bg-gradient-to-br from-[#0f3460] to-[#e94560] flex items-center justify-center">
        <span class="text-6xl">🌍</span>
      </div>
    )}

    <div class="p-5">
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-2 font-num">{formattedDate}</p>
      <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3 line-clamp-2 group-hover:text-[#e94560] transition-colors">
        {title}
      </h3>
      <p class="text-gray-600 dark:text-gray-300 text-sm line-clamp-3 leading-relaxed">
        {excerpt}
      </p>

      {labels.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {labels.slice(0, 3).map(label => (
            <span class="text-xs px-3 py-1 bg-[#e94560]/10 text-[#e94560] rounded-full font-medium">
              {label}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>
